# ==============================================================================
# NUST KINECTO SMART JACKET 2040 - Environment Setup Example
# Duplicate this file, rename it to '.env', and populate with localized tokens.
# NEVER commit the actual '.env' file containing true credentials to Git.
# ==============================================================================

# --- System Environment Configurations ---
ENVIRONMENT=development
DEBUG_MODE=true

# --- Unity & Simulation Server Configurations ---
UNITY_SIM_PORT=8080
MATLAB_DATA_BRIDGE_HOST=127.0.0.1

# --- Mock Hardware Deployment Endpoints ---
# Local network endpoints for testing the classroom attendance station
ATTENDANCE_STATION_URL="http://192.168.1"
ATTENDANCE_STATION_API_KEY="mock_nust_api_token_abcd1234efgh"

# --- Hardware Safety Threshold Defaults ---
# Hardware thermal cutoff threshold in degrees Celsius
MAX_SAFE_THERMAL_LIMIT=42.0
